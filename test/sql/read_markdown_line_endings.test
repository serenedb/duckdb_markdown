# name: test/sql/read_markdown_line_endings.test
# description: normalize_content, on by default, turns CRLF and lone CR line endings into LF; turned off, the file's bytes come back as they are
# group: [sql]

require markdown

statement ok
COPY (SELECT E'# Title\r\n\r\nSome *text* here.\r\rmore\r\n' AS md)
TO '{TEST_DIR}/line_endings.md' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query I
SELECT content = E'# Title\n\nSome *text* here.\n\nmore\n\n' FROM read_markdown('{TEST_DIR}/line_endings.md');
----
true

query I
SELECT content = E'# Title\n\nSome *text* here.\n\nmore\n\n' FROM read_markdown('{TEST_DIR}/line_endings.md', normalize_content = true);
----
true

query I
SELECT content = E'# Title\r\n\r\nSome *text* here.\r\rmore\r\n\n' FROM read_markdown('{TEST_DIR}/line_endings.md', normalize_content = false);
----
true

query II
SELECT title, replace(content, chr(10), '|') FROM read_markdown_sections('{TEST_DIR}/line_endings.md');
----
Title	Some *text* here.|more|

statement ok
COPY (SELECT E'# Title\r\rend' AS md)
TO '{TEST_DIR}/line_endings_cr.md' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '', NEW_LINE '\r');

query II
SELECT content = E'# Title\n\nend\n', normalize_content FROM (
  SELECT content, false AS normalize_content FROM read_markdown('{TEST_DIR}/line_endings_cr.md', normalize_content = false)
  UNION ALL
  SELECT content, true FROM read_markdown('{TEST_DIR}/line_endings_cr.md'))
ORDER BY normalize_content;
----
false	false
true	true
