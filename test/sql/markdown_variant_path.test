# name: test/sql/markdown_variant_path.test
# description: The readers take a path given as a VARIANT, as DuckDB's multi-file readers do
# group: [sql]

require markdown

query I
SELECT count(*) FROM read_markdown('test/markdown/simple.md'::VARIANT);
----
1

query T
SELECT section_id FROM read_markdown_sections('test/markdown/simple.md'::VARIANT) ORDER BY start_line;
----
simple-document
features

query I
SELECT count(*) > 0 FROM read_markdown_blocks('test/markdown/simple.md'::VARIANT);
----
true
